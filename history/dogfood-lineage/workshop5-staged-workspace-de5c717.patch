+    def _stage_source(self, workspace: Path, source: Path | None) -> None:
+        """Copy the owner's files into the staged workspace (TESP 5.3 step 4).
+
+        The workspace is the project, so it holds the project's source rather
+        than a description of it. A plain copy: a workspace is a working
+        directory, not a store, so nothing here is content-addressed.
+
+        Refused rather than guessed. A source that is missing, or is the
+        workspace itself, would publish a project that looks fine and is not.
+        """
+        if source is None:
+            _atomic_bytes(workspace / ".keep", b"")
+            return
+        source = Path(source)
+        if not source.is_dir():
+            raise ProjectError("source_missing", f"stage source {source} is not a directory")
+        if source.resolve() == workspace.resolve():
+            raise ProjectError("source_self", "a project cannot stage from its own workspace")
+        for path in sorted(source.rglob("*")):
+            relative = path.relative_to(source)
+            if not path.is_file():
+                continue
+            if any(part.startswith(".") for part in relative.parts) or _is_kernel(relative):
+                continue
+            _atomic_bytes(workspace / relative, path.read_bytes())
+
