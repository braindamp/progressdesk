+    def dispatch_task(self, project_id: str, task_id: str,
+                      tools: tuple[str, ...] = ()) -> dict[str, Any]:
+        """Run one round for one declared task, through the ordinary verb.
+
+        The board declares and gates but never runs a round, so S1 had no door.
+        This is not a second way in: it calls round.dispatch, the same verb the
+        CLI and the HTTP transport call. Tools default to empty because that is
+        what the verb means by empty -- no tools at all, not every tool.
+        """
+        from .runtime import route
+
+        row = next((r for r in fetch_all(self.conn, "task")
+                    if r["id"] == task_id
+                    and r["milestone_id"] in {
+                        m["id"] for m in fetch_all(self.conn, "milestone", project_id=project_id)
+                    }), None)
+        if row is None:
+            return {"ok": False, "error": "no such task in this project"}
+        outcome = route(self.runtime, "round.dispatch", {
+            "project_id": project_id,
+            "task_id": task_id,
+            "milestone_id": row["milestone_id"],
+            "slice": row["narrative"] or row["title"],
+            "tools": list(tools),
+        })
+        self.sync()
+        return {"ok": True, "outcome": outcome}
+
